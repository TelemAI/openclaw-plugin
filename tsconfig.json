{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "index.ts",
    "scripts/**/*.d.mts",
    "scripts/**/*.mts",
    "src/**/*.ts",
    "test/**/*.ts",
    "types/**/*.d.ts",
    "vitest.config.ts"
  ]
}
